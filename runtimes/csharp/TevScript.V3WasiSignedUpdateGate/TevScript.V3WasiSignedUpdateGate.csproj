<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup>
    <TevV3UpdateFixtureDir Condition="'$(TevV3UpdateFixtureDir)' == ''">$(MSBuildProjectDirectory)</TevV3UpdateFixtureDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TevScript.Core.V3\TevScript.Core.V3.csproj" />
    <ProjectReference Include="..\TevScript.Update\TevScript.Update.csproj" />
    <Content Include="$(TevV3UpdateFixtureDir)\base.ir.json" Link="base.ir.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="$(TevV3UpdateFixtureDir)\package1.json" Link="package1.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
