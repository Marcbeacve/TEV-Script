{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://tev-script.local/schemas/tev_script_reaction_contract_v1.schema.json",
  "title":"TEV Script Reaction Contract V1",
  "type":"object","additionalProperties":false,
  "required":["schema","contract_id","entity_id","trigger_event","allowed","budgets","required_atomicity","protocol","proof_obligations","contract_hash"],
  "properties":{
    "schema":{"const":"TEV_SCRIPT_REACTION_CONTRACT_V1"},"contract_id":{"$ref":"#/$defs/id"},"entity_id":{"$ref":"#/$defs/id"},"trigger_event":{"$ref":"#/$defs/id"},
    "allowed":{"type":"object","additionalProperties":false,"required":["state_reads","state_writes","observations","effects","emitted_events","resources"],"properties":{"state_reads":{"$ref":"#/$defs/ids"},"state_writes":{"$ref":"#/$defs/ids"},"observations":{"$ref":"#/$defs/ids"},"effects":{"$ref":"#/$defs/ids"},"emitted_events":{"$ref":"#/$defs/ids"},"resources":{"$ref":"#/$defs/ids"}}},
    "budgets":{"type":"object","additionalProperties":false,"required":["maximum_reachable_events","maximum_instruction_ceiling"],"properties":{"maximum_reachable_events":{"type":"integer","minimum":1},"maximum_instruction_ceiling":{"type":"integer","minimum":1}}},
    "required_atomicity":{"enum":["any","state_atomic","transactional","durable_transactional"]},
    "protocol":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/protocol"}]},
    "proof_obligations":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/obligation"}},
    "contract_hash":{"$ref":"#/$defs/sha"}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_.:/-]*$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "typedValue":{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"type":"string","minLength":1},"value":{}}},
    "edge":{"type":"object","additionalProperties":false,"required":["event_id","before","after"],"properties":{"event_id":{"$ref":"#/$defs/id"},"before":{"$ref":"#/$defs/typedValue"},"after":{"$ref":"#/$defs/typedValue"}}},
    "protocol":{"type":"object","additionalProperties":false,"required":["state_name","edges"],"properties":{"state_name":{"$ref":"#/$defs/id"},"edges":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/edge"}}}},
    "obligation":{"type":"object","additionalProperties":false,"required":["obligation_id","domain","statement_hash"],"properties":{"obligation_id":{"$ref":"#/$defs/id"},"domain":{"$ref":"#/$defs/id"},"statement_hash":{"$ref":"#/$defs/sha"}}}
  }
}
