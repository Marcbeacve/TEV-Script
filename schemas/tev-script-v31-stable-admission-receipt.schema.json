{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TEV_SCRIPT_V31_STABLE_ADMISSION_RECEIPT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "language_version",
    "repository",
    "branch",
    "technical_parent_commit",
    "technical_parent_receipt_sha256",
    "release_commit_sha",
    "release_tree_sha",
    "release_diff_hash",
    "descriptor_hash",
    "full_test_count",
    "full_skipped_tests",
    "wheel_filename",
    "wheel_sha256",
    "wheel_reproducible",
    "installed_v31_smoke",
    "installed_v3_compatibility",
    "installed_v2_compatibility",
    "stable_admission",
    "language_stable",
    "publication_eligible",
    "publication_authorized",
    "merge_authorized",
    "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "TEV_SCRIPT_V31_STABLE_ADMISSION_RECEIPT_V1"},
    "language_version": {"const": "3.1.0"},
    "repository": {"const": "Marcbeacve/TEV-Script"},
    "branch": {"const": "agent/tevscript-max-3-1-total-core-v1"},
    "technical_parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "technical_parent_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_diff_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "descriptor_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "full_test_count": {"type": "integer", "minimum": 1},
    "full_skipped_tests": {"const": 0},
    "wheel_filename": {"const": "tev_script_portable_reference-3.1.0-py3-none-any.whl"},
    "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wheel_reproducible": {"const": true},
    "installed_v31_smoke": {"const": "PASS"},
    "installed_v3_compatibility": {"const": "PASS"},
    "installed_v2_compatibility": {"const": "PASS"},
    "stable_admission": {"const": true},
    "language_stable": {"const": true},
    "publication_eligible": {"const": true},
    "publication_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
