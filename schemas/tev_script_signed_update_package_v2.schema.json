{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tev-script.local/schemas/tev_script_signed_update_package_v2.schema.json",
  "title": "TEV Script signed update package V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "body", "signature"],
  "properties": {
    "schema": {"const": "TEV_SCRIPT_SIGNED_UPDATE_PACKAGE_V2"},
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "channel_id",
        "program_id",
        "epoch",
        "sequence",
        "from_ir_semantic_hash",
        "target_ir_semantic_hash",
        "target_source_semantic_hash",
        "ir_sha256",
        "ir"
      ],
      "properties": {
        "schema": {"const": "TEV_SCRIPT_UPDATE_BODY_V2"},
        "channel_id": {"$ref": "#/$defs/stableId"},
        "program_id": {"$ref": "#/$defs/localName"},
        "epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "from_ir_semantic_hash": {"$ref": "#/$defs/sha256"},
        "target_ir_semantic_hash": {"$ref": "#/$defs/sha256"},
        "target_source_semantic_hash": {"$ref": "#/$defs/sha256"},
        "ir_sha256": {"$ref": "#/$defs/sha256"},
        "ir": {"$ref": "tev_script_program_ir_v3.schema.json"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"$ref": "#/$defs/stableId"},
        "key_id": {"$ref": "#/$defs/stableId"},
        "value": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  },
  "$defs": {
    "localName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
