{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TEV_SCRIPT_OMEGA0_CERTIFY_RECEIPT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "branch",
    "commit_sha",
    "tree_sha",
    "base_sha",
    "base_tree_sha",
    "omega_master_design_sha256",
    "omega_plan_sha256",
    "omega_frontier_plan_hash",
    "omega_test_count",
    "omega_skipped_tests",
    "full_test_count",
    "full_skipped_tests",
    "v2_governed_files_unchanged",
    "v2_authority_validation",
    "promotion_authority",
    "language_stable",
    "certify_full",
    "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "TEV_SCRIPT_OMEGA0_CERTIFY_RECEIPT_V1"},
    "repository": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "omega_master_design_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "omega_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "omega_frontier_plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "omega_test_count": {"type": "integer", "minimum": 0},
    "omega_skipped_tests": {"type": "integer", "minimum": 0},
    "full_test_count": {"type": "integer", "minimum": 0},
    "full_skipped_tests": {"type": "integer", "minimum": 0},
    "v2_governed_files_unchanged": {"const": true},
    "v2_authority_validation": {"const": "PASS"},
    "promotion_authority": {"const": false},
    "language_stable": {"const": false},
    "certify_full": {"const": true},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
