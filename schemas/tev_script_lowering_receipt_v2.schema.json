{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://tev-script.local/schemas/tev_script_lowering_receipt_v2.schema.json",
  "title":"TEV Script full V1 to IR V3 lowering receipt V2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","profile","source","target","proof_obligations","receipt_hash"],
  "properties":{
    "schema":{"const":"TEV_SCRIPT_LOWERING_RECEIPT_V2"},
    "profile":{"const":"TEV_SCRIPT_V1_TO_IR_V3_FULL_PROFILE_V1"},
    "source":{"$ref":"#/$defs/source"},
    "target":{"$ref":"#/$defs/target"},
    "proof_obligations":{"$ref":"#/$defs/proofs"},
    "receipt_hash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["schema","language_version","semantic_hash","artifact_sha256"],
      "properties":{
        "schema":{"const":"TEV_SCRIPT_LINKED_PROGRAM_V1"},
        "language_version":{"const":"1.0.0"},
        "semantic_hash":{"$ref":"#/$defs/hash"},
        "artifact_sha256":{"$ref":"#/$defs/hash"}
      }
    },
    "target":{
      "type":"object","additionalProperties":false,
      "required":["schema","language_version","lowering_profile","source_semantic_hash","semantic_hash","artifact_sha256"],
      "properties":{
        "schema":{"const":"TEV_SCRIPT_PROGRAM_IR_V3"},
        "language_version":{"const":"1.0.0"},
        "lowering_profile":{"const":"TEV_SCRIPT_V1_IR_V3_PROFILE_V1"},
        "source_semantic_hash":{"$ref":"#/$defs/hash"},
        "semantic_hash":{"$ref":"#/$defs/hash"},
        "artifact_sha256":{"$ref":"#/$defs/hash"}
      }
    },
    "proofs":{
      "type":"object","additionalProperties":false,
      "required":["source_semantic_hash_verified","source_hash_embedded_in_target","target_ir_v3_contract_validated","closed_runtime_type_table_validated","algebraic_value_types_preserved","forward_only_cfg_validated"],
      "properties":{
        "source_semantic_hash_verified":{"const":true},
        "source_hash_embedded_in_target":{"const":true},
        "target_ir_v3_contract_validated":{"const":true},
        "closed_runtime_type_table_validated":{"const":true},
        "algebraic_value_types_preserved":{"const":true},
        "forward_only_cfg_validated":{"const":true}
      }
    }
  }
}
