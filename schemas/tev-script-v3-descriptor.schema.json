{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"TEV_SCRIPT_V3_DESCRIPTOR_V1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","language_id","language_version","release_name","stable","promotion_authority","source_profiles","program_ir_profiles","semantic_basis","open_computation","implicit_unbounded_execution","ambient_authority","epistemic_qualifiers","derived_stdlib","descriptor_hash"],
  "properties":{
    "schema":{"const":"TEV_SCRIPT_V3_DESCRIPTOR_V1"},
    "language_id":{"const":"TEV-Script"},
    "language_version":{"const":"3.0.0"},
    "release_name":{"const":"TEVScript MAX"},
    "stable":{"type":"boolean"},
    "promotion_authority":{"const":false},
    "source_profiles":{"const":["semantic_process","v2_explicit_compatibility"]},
    "program_ir_profiles":{"const":["TEV_SCRIPT_PROGRAM_IR_V5_SEMANTIC_PROCESS_V1","V2_PROGRAM_IR_V4_EXPLICIT_COMPATIBILITY"]},
    "semantic_basis":{"const":["Field","Transformation","Apply"]},
    "open_computation":{"const":"BOUNDED_QUANTA_WITH_OMEGA_CONTINUATIONS_V1"},
    "implicit_unbounded_execution":{"const":false},
    "ambient_authority":{"const":false},
    "epistemic_qualifiers":{"const":["Hypothesis","Inferred","Observed","Predicted","Verified"]},
    "derived_stdlib":{"const":["Residual","Admission","Selection","Discovery","Realization"]},
    "descriptor_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
