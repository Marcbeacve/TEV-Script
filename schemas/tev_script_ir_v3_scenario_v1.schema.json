{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://tev-script.local/schemas/tev_script_ir_v3_scenario_v1.schema.json",
  "title":"TEV Script IR V3 portable conformance scenario V1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","scenario_id","program_semantic_hash","source_semantic_hash","capabilities","steps"],
  "properties":{
    "schema":{"const":"TEV_SCRIPT_IR_V3_SCENARIO_V1"},
    "scenario_id":{"$ref":"#/$defs/id"},
    "program_semantic_hash":{"$ref":"#/$defs/hash"},
    "source_semantic_hash":{"$ref":"#/$defs/hash"},
    "capabilities":{"type":"array","maxItems":8192,"items":{"$ref":"#/$defs/capabilityScript"}},
    "steps":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/invocation"}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_.:/-]*$"},
    "local":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*$"},
    "typeId":{"type":"string","minLength":1,"maxLength":1024},
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "typedValue":{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"$ref":"#/$defs/typeId"},"value":{}}},
    "capabilityCall":{"type":"object","additionalProperties":false,"required":["arguments"],"properties":{"arguments":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/typedValue"}},"return":{"$ref":"#/$defs/typedValue"}}},
    "capabilityScript":{"type":"object","additionalProperties":false,"required":["capability_id","calls"],"properties":{"capability_id":{"$ref":"#/$defs/id"},"calls":{"type":"array","maxItems":4096,"items":{"$ref":"#/$defs/capabilityCall"}}}},
    "invocation":{"type":"object","additionalProperties":false,"required":["entity_id","event_id","arguments"],"properties":{"entity_id":{"$ref":"#/$defs/local"},"event_id":{"$ref":"#/$defs/local"},"arguments":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/typedValue"}}}}
  }
}
