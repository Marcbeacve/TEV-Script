{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tev-script.local/schemas/tev_script_project_v1.schema.json",
  "title": "TEV Script Project V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "language_version",
    "default_target",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "TEV_SCRIPT_PROJECT_V1"
    },
    "language_version": {
      "const": "1.0.0"
    },
    "default_target": {
      "enum": ["auto", "irv2", "irv3"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 257,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 6,
        "maxLength": 1024,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.tevs$"
      }
    }
  }
}
