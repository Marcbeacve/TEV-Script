{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tev.dev/schemas/tev_script_conformance_receipt_v1.schema.json",
  "title": "TEV Script Conformance Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenario_id",
    "program_hash",
    "final_states",
    "emitted_events",
    "capability_trace",
    "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "TEV_SCRIPT_CONFORMANCE_RECEIPT_V1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "program_hash": {"$ref": "#/$defs/hash"},
    "final_states": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/finalState"}
    },
    "emitted_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/emittedEvent"}
    },
    "capability_trace": {
      "type": "array",
      "items": {"$ref": "#/$defs/capabilityTrace"}
    },
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "typeName": {
      "enum": ["Bool", "Int", "Rat", "Text", "Vec2", "Vec3", "Unit"]
    },
    "canonicalIntegerText": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$",
      "not": {"const": "-0"}
    },
    "intValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$int"],
      "properties": {"$int": {"$ref": "#/$defs/canonicalIntegerText"}}
    },
    "ratValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$rat"],
      "properties": {
        "$rat": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/canonicalIntegerText"},
            {"type": "string", "pattern": "^[1-9][0-9]*$"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "encodedValue": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "string"},
        {"type": "null"},
        {"$ref": "#/$defs/intValue"},
        {"$ref": "#/$defs/ratValue"},
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/ratValue"}
        }
      ]
    },
    "typedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"$ref": "#/$defs/typeName"},
        "value": {"$ref": "#/$defs/encodedValue"}
      }
    },
    "finalState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "state"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/identifier"},
        "state": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/typedState"}
        }
      }
    },
    "emittedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "event_id", "arguments"],
      "properties": {
        "entity_id": {"$ref": "#/$defs/identifier"},
        "event_id": {"$ref": "#/$defs/identifier"},
        "arguments": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/encodedValue"}
        }
      }
    },
    "capabilityTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "arguments", "result"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/stableId"},
        "arguments": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/encodedValue"}
        },
        "result": {"$ref": "#/$defs/encodedValue"}
      }
    }
  }
}
