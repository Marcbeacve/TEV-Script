{
  "authority_files": [
    "AGENTS.md",
    "CANONICAL_INDEX.json",
    "REPOSITORY_CHANNEL.json",
    "DESIGN_DECISION.json",
    "descriptor.json",
    "docs/CANON.md",
    "docs/STATUS.md",
    "spec/**",
    "schemas/**",
    "conformance/**",
    "docs/VALIDATION.md"
  ],
  "ignore": [
    ".git/**",
    ".venv/**",
    "**/__pycache__/**",
    "node_modules/**",
    "build/**",
    "dist/**",
    "artifacts/**",
    "reports/**",
    "receipts/**",
    "state/**",
    "**/bin/**",
    "**/obj/**"
  ],
  "publication": {
    "branch_prefix": "agent/",
    "default_mode": "draft_pull_request",
    "github_actions": false,
    "merge_authority": false
  },
  "repository": {
    "default_branch": "main",
    "name": "Marcbeacve/TEV-Script"
  },
  "repository_kind": "multi_language_specification_and_runtimes",
  "schema": "lrcp.repository-manifest/v1",
  "source_roots": [
    "spec",
    "schemas",
    "catalogs",
    "conformance",
    "tev_script",
    "javascript/src",
    "runtimes/csharp",
    "adapters",
    "tests",
    "examples"
  ],
  "validation": {
    "full_after_changed_files": 64,
    "rules": [
      {
        "commands": [
          [
            "python",
            "-c",
            "from pathlib import Path; Path('README.md').read_text(encoding='utf-8')"
          ]
        ],
        "exclude": [],
        "horizon": "FAST_METADATA",
        "include": [
          "*.md",
          "docs/**"
        ],
        "priority": 10,
        "rule_id": "metadata"
      },
      {
        "commands": [
          [
            "python",
            "RUN_PORTABLE_CONFORMANCE.py"
          ]
        ],
        "exclude": [],
        "horizon": "CAUSAL_CONTENT",
        "include": [
          "tev_script/**",
          "javascript/**",
          "conformance/**",
          "tests/**",
          "examples/**",
          "adapters/**"
        ],
        "priority": 20,
        "rule_id": "portable-core"
      },
      {
        "commands": [
          [
            "python",
            "RUN_TEV_SCRIPT_PLATFORM_COMPLETION.py"
          ]
        ],
        "exclude": [],
        "horizon": "PLATFORM_COMPLETION",
        "include": [
          "REPOSITORY_CHANNEL.json",
          "AGENTS.md",
          "CANONICAL_INDEX.json",
          "DESIGN_DECISION.json",
          "descriptor.json",
          "pyproject.toml",
          "requirements-certification.txt",
          "RUN_TEV_SCRIPT_PLATFORM_COMPLETION.py",
          "tev_script/platform_*.py",
          "tev_script/version.py",
          "tev_script/release_metadata_v31.py",
          "tools/**",
          "spec/**",
          "schemas/**",
          "conformance/**",
          "runtime_js_v31/**",
          "runtimes/csharp/**",
          "packaging/**",
          "docs/VALIDATION.md"
        ],
        "priority": 30,
        "rule_id": "platform-completion"
      }
    ]
  }
}
