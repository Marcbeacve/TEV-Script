{
  "authority_files": [
    "AGENTS.md",
    "CANONICAL_INDEX.json",
    "REPOSITORY_CHANNEL.json",
    "DESIGN_DECISION.json",
    "descriptor.json",
    "docs/CANON.md",
    "docs/STATUS.md",
    "spec/**",
    "schemas/**",
    "conformance/**",
    "docs/VALIDATION.md"
  ],
  "ignore": [
    ".git/**",
    ".venv/**",
    "**/__pycache__/**",
    "node_modules/**",
    "build/**",
    "dist/**",
    "artifacts/**",
    "reports/**",
    "receipts/**",
    "state/**",
    "**/bin/**",
    "**/obj/**"
  ],
  "publication": {
    "branch_prefix": "agent/",
    "default_mode": "draft_pull_request",
    "github_actions": false,
    "merge_authority": false
  },
  "repository": {
    "default_branch": "main",
    "name": "Marcbeacve/TEV-Script"
  },
  "repository_kind": "multi_language_specification_and_runtimes",
  "schema": "lrcp.repository-manifest/v1",
  "source_roots": [
    "spec",
    "schemas",
    "catalogs",
    "conformance",
    "tev_script",
    "javascript/src",
    "runtimes/csharp",
    "adapters",
    "tests",
    "examples"
  ],
  "validation": {
    "full_after_changed_files": 64,
    "rules": [
      {
        "commands": [
          [
            "python",
            "RUN_PORTABLE_CONFORMANCE.py"
          ]
        ],
        "exclude": [],
        "horizon": "PORTABLE_CONFORMANCE",
        "include": [
          "spec/**",
          "schemas/**",
          "tev_script/**",
          "javascript/**",
          "conformance/**",
          "tests/**",
          "examples/**",
          "runtimes/csharp/**"
        ],
        "priority": 100,
        "rule_id": "portable-core"
      }
    ]
  }
}
