{
  "name": "@tev-script/runtime",
  "version": "0.2.0",
  "description": "Portable JavaScript runtime for TEV_SCRIPT_PROGRAM_IR_V2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/runtime.d.ts",
      "import": "./src/runtime.mjs"
    },
    "./canonical": {
      "types": "./src/canonical.d.ts",
      "import": "./src/canonical.mjs"
    },
    "./conformance": {
      "types": "./src/conformance.d.ts",
      "import": "./src/conformance.mjs"
    },
    "./strict-json": {
      "types": "./src/strict-json.d.ts",
      "import": "./src/strict-json.mjs"
    },
    "./strict-json-node": {
      "types": "./src/strict-json-node.d.ts",
      "import": "./src/strict-json-node.mjs"
    },
    "./ir-validation": {
      "types": "./src/ir-validation.d.ts",
      "import": "./src/ir-validation.mjs"
    },
    "./ir-flow": {
      "types": "./src/ir-flow.d.ts",
      "import": "./src/ir-flow.mjs"
    }
  },
  "files": [
    "src/canonical.mjs",
    "src/canonical.d.ts",
    "src/strict-json.d.ts",
    "src/strict-json.mjs",
    "src/strict-json-node.d.ts",
    "src/strict-json-node.mjs",
    "src/ir-validation.mjs",
    "src/ir-validation.d.ts",
    "src/ir-flow.mjs",
    "src/ir-flow.d.ts",
    "src/values.mjs",
    "src/runtime.mjs",
    "src/runtime.d.ts",
    "src/conformance.mjs",
    "src/conformance.d.ts",
    "src/run-conformance.mjs",
    "test/runtime.test.mjs",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/runtime.test.mjs",
    "conformance": "node src/run-conformance.mjs fixtures/conformance/player.scenario.json"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
